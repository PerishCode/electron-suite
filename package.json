{
  "name": "electron-suite",
  "private": true,
  "type": "module",
  "engines": {
    "node": "~24",
    "pnpm": ">=10.33.2"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "package": "node scripts/package.mjs",
    "qualify": "node scripts/acceptance.mjs",
    "build": "pnpm -r --if-present --workspace-concurrency=4 run build",
    "guard": "pesuite guard",
    "test": "pnpm -r --if-present --workspace-concurrency=4 run test",
    "typecheck": "pnpm -r --if-present --workspace-concurrency=4 run typecheck",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@perishcode/config": "workspace:*",
    "@perishcode/guard": "workspace:*",
    "@perishcode/pack": "workspace:*",
    "@perishcode/release": "workspace:*",
    "@perishcode/testkit": "workspace:*",
    "@perishcode/cli": "workspace:*",
    "@biomejs/biome": "2.6.4",
    "typescript": "7.0.2",
    "vitest": "4.1.6"
  },
  "packageManager": "pnpm@11.13.0"
}
