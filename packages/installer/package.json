{
  "name": "@perishcode/installer",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./worker": "./dist/worker.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "biome check .",
    "test": "vitest run -c vitest.config.ts",
    "build": "node esbuild.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@perishcode/protocol": "workspace:*",
    "@perishcode/distribution": "workspace:*",
    "@perishcode/release": "workspace:*",
    "@perishcode/sidecar": "workspace:*",
    "yauzl": "3.4.0",
    "plist": "5.0.0"
  },
  "devDependencies": {
    "@perishcode/sidecar": "workspace:*",
    "@types/node": "24.12.2",
    "esbuild": "0.28.0",
    "typescript": "7.0.2",
    "vitest": "4.1.6",
    "@types/yauzl": "3.4.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerishCode/electron-suite.git",
    "directory": "packages/installer"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Managed macOS shell installation handoff and recovery",
  "sideEffects": [
    "./dist/worker.mjs"
  ]
}
