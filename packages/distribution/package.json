{
  "name": "@perishcode/distribution",
  "version": "0.1.4",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./s3": {
      "types": "./dist/s3.d.ts",
      "default": "./dist/s3.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "biome check .",
    "test": "vitest run -c vitest.config.ts",
    "build": "node esbuild.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@perishcode/protocol": "workspace:*",
    "@perishcode/publish": "workspace:*",
    "@perishcode/release": "workspace:*",
    "@aws-sdk/client-s3": "3.1161.0"
  },
  "devDependencies": {
    "@perishcode/sidecar": "workspace:*",
    "@types/node": "24.12.2",
    "esbuild": "0.28.0",
    "typescript": "7.0.2",
    "vitest": "4.1.6"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerishCode/electron-suite.git",
    "directory": "packages/distribution"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Signed product catalogs, shell negotiation and S3 distribution"
}
