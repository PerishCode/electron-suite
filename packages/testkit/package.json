{
  "name": "@pesuite/testkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run -c vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@pesuite/capsule": "workspace:*",
    "@pesuite/carrier": "workspace:*",
    "@pesuite/guard": "workspace:*",
    "@pesuite/pack": "workspace:*",
    "@pesuite/protocol": "workspace:*",
    "@pesuite/publish": "workspace:*",
    "@pesuite/release": "workspace:*",
    "@pesuite/sidecar": "workspace:*"
  },
  "devDependencies": {
    "@pesuite/daemon": "workspace:*",
    "@pesuite/web": "workspace:*",
    "@types/node": "24.12.2",
    "electron": "41.3.0",
    "esbuild": "0.28.0",
    "typescript": "7.0.2",
    "vitest": "4.1.6"
  }
}
