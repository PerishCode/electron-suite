{
  "name": "@perishcode/cli",
  "version": "0.4.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "src/pesuite.mjs",
    "dist"
  ],
  "scripts": {
    "lint": "biome check .",
    "test": "vitest run -c vitest.config.ts",
    "build": "node esbuild.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.tests.json"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "esbuild": "0.28.0",
    "typescript": "7.0.2",
    "vitest": "4.1.6"
  },
  "description": "Unified pesuite command line",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerishCode/electron-suite.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@perishcode/guard": "workspace:*",
    "@perishcode/runtime": "workspace:*",
    "@perishcode/release": "workspace:*",
    "@perishcode/pack": "workspace:*"
  },
  "bin": {
    "pesuite": "./src/pesuite.mjs"
  }
}
